rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return isSignedIn() && userDoc().data.isAdmin == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId)
        && request.resource.data.slug == userId
        && request.resource.data.isAdmin == false;
      allow update: if isAdmin()
        || (
          isOwner(userId)
          && request.resource.data.slug == resource.data.slug
          && request.resource.data.isAdmin == resource.data.isAdmin
        );
      allow delete: if isAdmin();
    }

    match /topics/{topicId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /exercises/{exerciseId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.isActive == false
        && request.resource.data.author == userDoc().data.username;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /exercise_details/{exerciseId} {
      allow read: if true;
      // Per-item shape (label/url/provider/free) isn't enforced here since
      // Firestore rules can't validate arbitrary-length array contents;
      // that's done server-side in POST /api/exercises. This only guards
      // type and a sane upper bound.
      allow create: if isSignedIn()
        && request.resource.data.slug == exerciseId
        && request.resource.data.text is string
        && (
          !("practiceLinks" in request.resource.data)
          || (
            request.resource.data.practiceLinks is list
            && request.resource.data.practiceLinks.size() <= 10
          )
        );
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
